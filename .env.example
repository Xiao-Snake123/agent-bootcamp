# ============================================================
# Agent Bootcamp 环境变量模板
# 使用方法：复制为 .env 后填入真实值  ->  cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库；本模板文件可提交（不含任何密钥）。
# 只需填你打算用的服务；不用的留空即可。
# ============================================================

# ---------- 1. 大模型 LLM（至少填一个；OpenAI 为默认后端）----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 国内 / OpenAI 兼容网关（填其一；base_url 已预设，仅填 key+model）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=            # 通义千问（阿里云）
DASHSCOPE_MODEL=qwen-plus
ZHIPU_API_KEY=               # 智谱 GLM（清华）
ZHIPU_MODEL=glm-4
CUSTOM_BASE_URL=             # 任意 OpenAI 兼容网关（如自建/第三方）
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Anthropic（独立 SDK，需 ANTHROPIC_API_KEY）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------- 2. K8 RAG 检索增强 ----------
VOYAGE_API_KEY=             # Voyage 嵌入模型
COHERE_API_KEY=             # Cohere 嵌入 / Rerank
PINECONE_API_KEY=           # 云端向量库（本地 Chroma 不需要 key）
QDRANT_API_KEY=
WEAVIATE_API_KEY=

# ---------- 3. K9 MCP 外部集成（按所用 server 填）----------
GITHUB_PERSONAL_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
NOTION_API_KEY=
# 文件系统 / 本地 MCP server 不需要 key

# ---------- 4. Capstone 搜索 / 检索（主题A 研究助理常用）----------
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---------- 5. K12 可观测 / 评估（LangSmith 等）----------
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-bootcamp
